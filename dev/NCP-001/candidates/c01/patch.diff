+        x: &[f32],
+        first: usize,
+        per_row: usize,
+        out: &mut [f32; ROWS],
+    ) {
+        let stride = per_row * Q8_0_BLOCK_BYTES;
+        assert!((first + ROWS) * stride <= blocks.len() && x.len() == per_row * Q8_0_BLOCK_ELEMS);
