;; Every process that compiles or links candidate code runs under this: no network, no reading the held-out set, the
;; evaluator, the checker or anything else in the home directory, and writes only to the evaluator's scratch files.
(version 1)
(allow default)
(deny network*)
(deny file-read-data (subpath (param "HOME")))
(allow file-read-data
  (subpath (string-append (param "HOME") "/.cargo"))
  (subpath (string-append (param "HOME") "/.rustup"))
  (subpath (string-append (param "HOME") "/chris-models/q8enc-ad82acba"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/build"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/harness"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/bin"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/conform-dev"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/workload-dev"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/target-larql"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/target-harness"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/scratch")))
(deny file-read* (subpath (string-append (param "HOME") "/chris-models/ncp001/hidden"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/validate"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/build/verifier"))
  (subpath (string-append (param "HOME") "/chris-source/transformer-verifiers"))
  (subpath (string-append (param "HOME") "/chris-source/ncp001-candidate"))
  (subpath "/private/tmp/claude-501")
  (subpath "/Volumes"))
;; A later file-read* rule doesn't override the allow above, so the one denied path inside an allowed tree needs this form too.
(deny file-read-data (subpath (string-append (param "HOME") "/chris-models/ncp001/build/verifier")))
(deny file-write* (subpath (param "HOME")))
(allow file-write*
  (subpath (string-append (param "HOME") "/.cargo/registry"))
  (regex (string-append "^" (param "HOME") "/\\.cargo/\\."))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/target-larql"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/target-harness"))
  (subpath (string-append (param "HOME") "/chris-models/ncp001/scratch")))
